# /etc/kumo/kumo.env (mode 640, root:kumo)
# After changing the agent URL or token run: kumo-setup-token

# Host storage agent, host side of the vmd tap
KUMO_AGENT_URL=http://100.64.1.2:9090
# Printed once by `kumoctl vm add` / `kumoctl vm rotate` on the host
KUMO_AGENT_TOKEN=

# Optional single-user password for the web UI. Empty = open to the LAN.
KUMO_PASSWORD=

# Session signing key, generated by install.sh
KUMO_SECRET=

# SQLite database and the temp folder yt-dlp downloads into.
# The temp disk must hold your largest documentary.
KUMO_DATA=/var/lib/kumo
KUMO_TMP=/var/lib/kumo/tmp

# Retries for transient failures (network drops, agent restarts)
KUMO_MAX_ATTEMPTS=4
